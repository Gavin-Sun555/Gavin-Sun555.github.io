[{"author":null,"categories":null,"content":null,"date":1762041600,"description":"","dir":"post/","excerpt_html":null,"excerpt_text":null,"expirydate":-62135596800,"fuzzywordcount":100,"html":null,"keywords":null,"kind":"page","lang":"en","lastmod":1762041600,"objectID":"ce4382742ac9a09be35619244a10f5cb","permalink":"https://gavin-sun555.github.io/2025/11/01/ancient-egypt-history/","publishdate":"2025-11-02T00:00:00Z","readingtime":0,"relpermalink":"/2025/11/01/ancient-egypt-history/","section":"post","summary":"","tags":null,"title":"Ancient Egypt History","type":"post","url":"/2025/11/01/ancient-egypt-history/","weight":0,"wordcount":0},{"author":null,"categories":null,"content":null,"date":1759276800,"description":"","dir":"post/","excerpt_html":null,"excerpt_text":null,"expirydate":-62135596800,"fuzzywordcount":400,"html":null,"keywords":null,"kind":"page","lang":"en","lastmod":1759276800,"objectID":"1589c3f748f83b4bb874d770431121c5","permalink":"https://gavin-sun555.github.io/2025/10/01/travel-blog-japan/","publishdate":"2025-10-01T00:00:00Z","readingtime":1,"relpermalink":"/2025/10/01/travel-blog-japan/","section":"post","summary":"\u003cp\u003e\u003cstrong\u003eJapan in 7 Days: Shinkansen, Shrines, and Sapporo Surprises\u003c/strong\u003e\u003cbr\u003e\nAfter a fascinating few weeks in China, I hopped over to Japan for a whirlwind one-week tour. Armed with a rail pass, I zipped from ancient castles in the south to the vibrant cities of the north, experiencing the incredible efficiency and beauty the country has to offer.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eKansai \u0026amp; Beyond on the Rails\u003c/strong\u003e\u003cbr\u003e\nMy journey began with a ride on the adorable Hello Kitty Shinkansen to visit the magnificent Himeji Castle. The next few days were a blur of train travel and sightseeing. I paid a visit to the solemn sites of Hiroshima and the beautiful island of Miyajima , and later traveled to see the stunning Amanohashidate sandbar. One particularly ambitious day involved hopping between five different cities: Okayama, Takamatsu, Fukuyama, Onomichi, and Mihara.\u003c/p\u003e","tags":null,"title":"Travel Blog Japan","type":"post","url":"/2025/10/01/travel-blog-japan/","weight":0,"wordcount":395},{"author":null,"categories":null,"content":null,"date":1759276800,"description":"","dir":"post/","excerpt_html":null,"excerpt_text":null,"expirydate":-62135596800,"fuzzywordcount":500,"html":null,"keywords":null,"kind":"page","lang":"en","lastmod":1759276800,"objectID":"6fb368567ced141f20b6bc86a371c278","permalink":"https://gavin-sun555.github.io/2025/10/01/travel-blog-kazakhstan/","publishdate":"2025-10-01T00:00:00Z","readingtime":3,"relpermalink":"/2025/10/01/travel-blog-kazakhstan/","section":"post","summary":"\u003ch3 id=\"-a-journey-through-kazakhstan-almaty--astana\"\u003e🇰🇿 A Journey Through Kazakhstan: Almaty \u0026amp; Astana\u003c/h3\u003e\n\u003cp\u003eMy trip to Kazakhstan took me to its two largest cities, starting in the former capital, Almaty, and then traveling to the modern capital, Astana. It\u0026rsquo;s my first time to visit central Asia.\u003c/p\u003e\n\u003ch4 id=\"almaty-the-southern-capital\"\u003eAlmaty: The Southern Capital\u003c/h4\u003e\n\u003cp\u003eMy time in Almaty began on October 2nd with a city walk, where I noted the presence of many Soviet-era buildings. The following day, I explored the natural landmarks surrounding the city:\u003c/p\u003e","tags":null,"title":"Travel Blog Kazakhstan","type":"post","url":"/2025/10/01/travel-blog-kazakhstan/","weight":0,"wordcount":450},{"author":null,"categories":null,"content":null,"date":1755388800,"description":"","dir":"post/","excerpt_html":null,"excerpt_text":null,"expirydate":-62135596800,"fuzzywordcount":100,"html":null,"keywords":null,"kind":"page","lang":"en","lastmod":1755388800,"objectID":"b2b1871e2a5af6f11db1dd10ad7bd5c9","permalink":"https://gavin-sun555.github.io/2025/08/17/hello-world/","publishdate":"2025-08-17T00:00:00Z","